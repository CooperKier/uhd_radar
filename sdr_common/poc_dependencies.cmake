# Shared dependencies, with independent TX and RX build directories.
if(DEFINED ENV{CONDA_PREFIX})
  list(PREPEND CMAKE_PREFIX_PATH "$ENV{CONDA_PREFIX}")
endif()
find_package(UHD 4.9 REQUIRED)
find_package(yaml-cpp REQUIRED)
find_package(Threads REQUIRED)
find_package(Boost REQUIRED CONFIG)
add_library(poc_dependencies INTERFACE)
target_compile_features(poc_dependencies INTERFACE cxx_std_17)
target_include_directories(poc_dependencies INTERFACE ${UHD_INCLUDE_DIRS} ${Boost_INCLUDE_DIRS}
  ${YAML_CPP_INCLUDE_DIR} ${YAML_CPP_INCLUDE_DIRS} ${CMAKE_CURRENT_LIST_DIR})
if(TARGET yaml-cpp::yaml-cpp)
  set(POC_YAML_TARGET yaml-cpp::yaml-cpp)
elseif(TARGET yaml-cpp)
  set(POC_YAML_TARGET yaml-cpp)
else()
  set(POC_YAML_TARGET ${YAML_CPP_LIBRARIES})
endif()
target_link_libraries(poc_dependencies INTERFACE ${UHD_LIBRARIES} ${POC_YAML_TARGET} Threads::Threads)
